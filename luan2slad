-- run as-is; hooks armed, then loader fires

local out_dir = "luarmor_dump"

local function safe_write(name, data)
    local ok, err = pcall(function()
        if not isfolder(out_dir) then makefolder(out_dir) end
        writefile(out_dir .. "/" .. name, data)
    end)
    if not ok then warn("[dump] write failed: " .. tostring(err)) end
end

local counter = 0
local function next_name(tag)
    counter = counter + 1
    return string.format("%s_%03d_%d.lua", tag, counter, os.time())
end

-- 1) loadstring hook
local old_loadstring = loadstring
if hookfunction then
    hookfunction(old_loadstring, newcclosure(function(src, chunkname)
        if type(src) == "string" and #src > 0 then
            local fname = next_name("loadstring")
            safe_write(fname, src)
            print("[dump] loadstring -> " .. fname .. " (" .. #src .. " bytes)")
        end
        return old_loadstring(src, chunkname)
    end))
else
    warn("[dump] no hookfunction — loadstring hook skipped")
end

-- 2) HttpGet hook
local HttpGet = game.HttpGet
if hookfunction and type(HttpGet) == "function" then
    hookfunction(HttpGet, newcclosure(function(self, url, ...)
        local res = HttpGet(self, url, ...)
        if type(res) == "string" and #res > 0 then
            local fname = next_name("httpget")
            safe_write(fname, res)
            print("[dump] HttpGet " .. tostring(url) .. " -> " .. fname .. " (" .. #res .. " bytes)")
        end
        return res
    end))
end

-- 3) getscriptclosure hook
if hookfunction and type(getscriptclosure) == "function" then
    local old_gsc = getscriptclosure
    hookfunction(old_gsc, newcclosure(function(script)
        local f = old_gsc(script)
        if type(f) == "function" and getfunctionbytecode then
            local ok, bc = pcall(getfunctionbytecode, f)
            if ok and type(bc) == "string" and #bc > 0 then
                local fname = next_name("gsc_bytecode")
                safe_write(fname, bc)
                print("[dump] getscriptclosure -> " .. fname .. " (" .. #bc .. " bytes)")
            end
        end
        return f
    end))
end

print("[dump] armed. firing loader.")

-- fire the loader
