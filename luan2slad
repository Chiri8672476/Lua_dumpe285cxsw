    "script-section": "Скрипт дампа",
    copy: "Копировать",
    copied: "Скопировано!",
    "keys-section": "Пожизненные ключи",
    footer: "Lua Dump © 2024 — Все ключи пожизненные"
  }
};

let lang = 'en';

function applyLang() {
  const t = i18n[lang];
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const k = el.getAttribute('data-i18n');
    if (t[k] !== undefined) el.textContent = t[k];
  });
  document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
    const k = el.getAttribute('data-i18n-placeholder');
    if (t[k] !== undefined) el.placeholder = t[k];
  });
  // Update copy button if it shows "copied"
  const copyLabel = document.getElementById('copy-label');
  if (copyLabel && !document.getElementById('copy-btn').classList.contains('copied')) {
    copyLabel.textContent = t.copy;
  }
  // Lang button
  const langLabel = document.getElementById('lang-label');
  const flag = document.querySelector('.lang-btn .flag');
  if (lang === 'en') {
    langLabel.textContent = 'EN';
    flag.textContent = '🇺🇸';
  } else {
    langLabel.textContent = 'RU';
    flag.textContent = '🇷🇺';
  }
}

function toggleLang() {
  lang = lang === 'en' ? 'ru' : 'en';
  applyLang();
}

// ── Syntax highlight ──
function highlight(code) {
  const keywords = /\b(local|function|if|then|else|elseif|end|do|while|for|in|return|and|or|not|true|false|nil|repeat|until|break)\b/g;
  const builtins = /\b(print|warn|pcall|type|tostring|string\.format|os\.time|loadstring|hookfunction|newcclosure|getscriptclosure|getfunctionbytecode|isfolder|makefolder|writefile|game)\b/g;
  const strings = /"([^"\\]|\\.)*"|'([^'\\]|\\.)*'/g;
  const comments = /--[^\n]*/g;
  const numbers = /\b\d+\b/g;

  const esc = s => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const P = '\x00'; // placeholder char

  let parts = [];
  let result = code;

  function mask(re, cls) {
    result = result.replace(re, m => {
      const id = parts.length;
      parts.push(`<span class="${cls}">${esc(m)}</span>`);
      return P + id + P;
    });
  }

  mask(comments, 'cm');
  mask(strings, 'str');
  mask(builtins, 'fn');
  mask(keywords, 'kw');
  mask(numbers, 'num');

  result = esc(result);
  result = result.replace(new RegExp(P + '(\\d+)' + P, 'g'), (_, id) => parts[+id]);
  return result;
}

// ── Render script ──
document.getElementById('script-pre').innerHTML = highlight(SCRIPT_RAW);

// ── Render keys ──
const grid = document.getElementById('keys-grid');
KEYS.forEach((k, i) => {
  const chip = document.createElement('div');
  chip.className = 'key-chip';
  chip.textContent = k;
  chip.title = `Key ${i+1}`;
  grid.appendChild(chip);
});

// ── Auth ──
function tryAuth() {
  const val = document.getElementById('key-field').value.trim().toUpperCase();
  const field = document.getElementById('key-field');
  const errEl = document.getElementById('auth-error');

  if (KEYS.includes(val)) {
    document.getElementById('auth-screen').style.display = 'none';
    const dash = document.getElementById('dashboard');
    dash.classList.add('visible');
  } else {
    field.classList.add('error');
    errEl.classList.add('show');
    setTimeout(() => field.classList.remove('error'), 400);
  }
}

document.getElementById('key-field').addEventListener('keydown', e => {
  if (e.key === 'Enter') tryAuth();
  document.getElementById('auth-error').classList.remove('show');
});

// ── Copy ──
function copyScript() {
  const btn = document.getElementById('copy-btn');
  const label = document.getElementById('copy-label');
  const t = i18n[lang];

  navigator.clipboard.writeText(SCRIPT_RAW).then(() => {
    btn.classList.add('copied');
    label.textContent = t.copied;
    setTimeout(() => {
      btn.classList.remove('copied');
      label.textContent = t.copy;
    }, 2000);
  }).catch(() => {
    const ta = document.createElement('textarea');
    ta.value = SCRIPT_RAW;
    ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    btn.classList.add('copied');
    label.textContent = t.copied;
    setTimeout(() => {
      btn.classList.remove('copied');
      label.textContent = t.copy;
    }, 2000);
  });
}

// Init
applyLang();
</script>

